*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:#65c7ed}button,input{font:inherit}.screen{position:relative;width:100vw;height:100dvh;overflow:hidden}.backdrop{position:absolute;inset:0;background:url("mundo_inicio.png") center/cover no-repeat;filter:blur(12px) brightness(.72);transform:scale(1.08)}.artboard{position:absolute;top:0;left:50%;width:min(100vw,1000px);aspect-ratio:2/3;transform:translateX(-50%);overflow:hidden;box-shadow:0 0 50px rgba(0,0,0,.18)}.master{position:absolute;inset:0;width:100%;height:100%;object-fit:fill;display:block}.hot{position:absolute;border:0;background:transparent;padding:0;cursor:pointer;z-index:15}.lang{top:2.5%;right:2.5%;width:25%;height:6.5%}.juega{left:1.5%;top:33.5%;width:23%;height:5.8%}.aprende{left:1.5%;top:39%;width:23%;height:5.8%}.explora{left:1.5%;top:44.5%;width:23%;height:5.8%}.crece{left:1.5%;top:50%;width:23%;height:5.8%}.hot:active{transform:scale(.97)}.robot{position:absolute;z-index:12;left:51%;top:35%;width:31%;transform:translate(-50%,-50%);animation:float 3.2s ease-in-out infinite;filter:drop-shadow(0 13px 10px rgba(19,50,77,.28));pointer-events:none}.robot img{display:block;width:100%;height:auto}.robot.talking{animation:talk .45s ease-in-out infinite alternate}.robot.excited{animation:jump .5s ease-in-out 3}.robot.listening{animation:listen 1s ease-in-out infinite alternate}@keyframes float{50%{transform:translate(-50%,-56%) rotate(1deg)}}@keyframes talk{to{transform:translate(-50%,-54%) scale(1.025)}}@keyframes jump{50%{transform:translate(-50%,-64%) rotate(-3deg) scale(1.05)}}@keyframes listen{to{transform:translate(-50%,-55%) scale(1.02)}}.speech{position:absolute;z-index:14;top:13%;left:57%;width:38%;min-height:12%;padding:1.7% 2%;background:#fff;border-radius:24px;box-shadow:0 9px 25px rgba(18,45,68,.22);color:#17324d;text-align:center;font-size:clamp(12px,1.7vw,22px);line-height:1.2}.speech strong{display:block;font-size:1.22em;margin-bottom:3px}.speech span{display:block}.speech:after{content:"";position:absolute;left:15%;bottom:-18px;border:19px solid transparent;border-top-color:#fff;border-left:0}.name-card{position:absolute;z-index:20;left:50%;bottom:4.5%;transform:translateX(-50%);width:38%;padding:1.5%;background:rgba(255,255,255,.96);border-radius:18px;box-shadow:0 9px 24px rgba(18,45,68,.24)}.name-card input{width:100%;height:34px;border:2px solid #b9ddea;border-radius:11px;padding:0 10px;outline:none;font-size:14px}.continue,.voice{width:100%;border:0;border-radius:10px;margin-top:5px;height:31px;font-size:12px;font-weight:900;cursor:pointer}.continue{background:#ffd84d;color:#513d00}.voice{background:#55b7e8;color:#fff}.name-card p{margin:4px 0 0;text-align:center;font-size:8px;color:#536b78}.micState{text-align:center;font-size:9px;font-weight:800;min-height:12px;margin-top:2px}.water{position:absolute;z-index:5;left:66%;top:39%;width:16%;height:25%;pointer-events:none;opacity:.25;background:linear-gradient(180deg,transparent 0 18%,rgba(255,255,255,.7) 20% 23%,transparent 25% 40%,rgba(255,255,255,.6) 43% 46%,transparent 48% 64%,rgba(255,255,255,.55) 67% 70%,transparent 72%);background-size:100% 180%;animation:waterMove 2.2s linear infinite;mix-blend-mode:screen}@keyframes waterMove{to{background-position:0 100%}}.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}.disabled{opacity:.5;pointer-events:none}@media(max-width:600px){.artboard{width:100vw}.speech{top:11.5%;left:55%;width:40%;padding:2.2% 2.6%;font-size:12px;border-radius:18px}.speech:after{bottom:-13px;border-width:14px}.robot{left:53%;top:31%;width:31%}.name-card{width:41%;bottom:4%;padding:1.6%;border-radius:14px}.name-card input{height:28px;font-size:11px}.continue,.voice{height:27px;font-size:10px;margin-top:4px}.name-card p{font-size:6.5px}.micState{font-size:7px}.water{left:68%;top:39%;width:15%;height:22%}}@media(min-width:601px){.name-card{width:330px}.robot{width:300px}.speech{width:360px}.water{width:130px}}
